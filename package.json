{
  "name": "@flyvende/ai-office",
  "version": "2.1.0",
  "description": "See every AI coding agent on your machine as a tiny animated ASCII office — plus a live metrics dashboard, session history, and a headless event stream.",
  "main": "src/index.js",
  "bin": {
    "ai-office": "bin/ai-office.js"
  },
  "files": [
    "bin/",
    "src/",
    "config/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/ai-office.js",
    "demo": "node bin/ai-office.js --demo",
    "dashboard": "node bin/ai-office.js --dashboard",
    "watch": "node bin/ai-office.js --watch",
    "history": "node bin/ai-office.js --history",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "terminal",
    "tui",
    "ascii-art",
    "ai-agent",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "aider",
    "process-monitor",
    "dashboard",
    "observability"
  ],
  "author": "Tobias Preisler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flyvendedk799/ai-office.git"
  },
  "homepage": "https://github.com/Flyvendedk799/ai-office#readme",
  "bugs": {
    "url": "https://github.com/Flyvendedk799/ai-office/issues"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  },
  "engines": {
    "node": ">=18"
  }
}
